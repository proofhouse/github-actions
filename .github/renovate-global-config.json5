{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // Shared global-only Renovate configuration for the proofhouse org.
  // Every repo references this through `globalExtends` in its own
  // `.github/renovate.json5`:
  //
  //   globalExtends: ["github>proofhouse/github-actions//.github/renovate-global-config.json5"]
  //
  // Unlike `extends` (resolved at repository scope), `globalExtends` is
  // resolved while Renovate assembles its global config, which is the only
  // scope where these self-hosted options take effect. The one global-only
  // option that can't be shared is `repositories`, which names the single
  // repo each install targets — that stays inline per repo.

  // Self-hosted Renovate reads each repo's `.github/renovate.json5` as its
  // global config first and then again as the per-repo config; without
  // `requireConfig: "ignored"` that double-read is logged as a warning
  // every run.
  requireConfig: "ignored",

  // Authenticated identity. `username` is what GitHub recognizes as the
  // App's bot login; `gitAuthor` is what shows up in `git log` and in the
  // DCO `Signed-off-by:` trailer.
  //
  // The numeric prefix on the gitAuthor email is the proofhouse-renovate
  // bot account's own user id (distinct from the App id), recovered with
  // `gh query users/proofhouse-renovate[bot] --jq .id`. gitSignOff (set in
  // the repo-level preset) needs a valid noreply address here to construct
  // the Signed-off-by line.
  username: "proofhouse-renovate[bot]",
  gitAuthor: "proofhouse-renovate[bot] <289255489+proofhouse-renovate[bot]@users.noreply.github.com>",

  // Renovate's default rate limits assume a hosted SaaS context. For a
  // self-hosted run on a cron we want every actionable PR opened on each
  // pass; rate-limiting just stretches updates across multiple runs.
  prConcurrentLimit: 0,
  prHourlyLimit: 0,
}
